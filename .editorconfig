root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{json,json5,jsonc,js,jsx,ts,tsx,vue,yml,yaml,md,html,css}]
indent_style = space
indent_size = 2

[*.{toml,ini}]
indent_style = space
indent_size = 2
