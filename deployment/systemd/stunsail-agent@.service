[Unit]
Description=StunSail Moonraker Agent %I
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=stunsail-agent
Group=stunsail-agent
WorkingDirectory=/opt/stunsail/current
EnvironmentFile=/etc/stunsail/agent/%I/agent.env
ExecStart=/opt/stunsail/current/.venv/bin/stunsail-agent run --config /etc/stunsail/agent/%I/agent.yaml
Restart=on-failure
RestartSec=5
StateDirectory=stunsail/agent/%I
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
