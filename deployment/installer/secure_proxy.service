[Unit]
Description=StunSail Secure Proxy Frontend
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/stunsail/current/deployment/installer
ExecStart=/usr/bin/python3 /opt/stunsail/current/deployment/installer/secure_proxy.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target