{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "StunSail API (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["stunsail_api.main:app", "--port", "8000", "--reload"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "env": { "STUNSAIL_DATABASE_URL": "sqlite:///data/stunsail-dev.db" },
      "preLaunchTask": "db: migrate dev database",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "StunSail Web (Vite + Chrome)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/web",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://localhost:\\d+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/apps/web/src"
      }
    }
  ],
  "compounds": [
    {
      "name": "StunSail: API + Web",
      "configurations": ["StunSail API (debug)", "StunSail Web (Vite + Chrome)"],
      "stopAll": true,
      "presentation": { "order": 1 }
    }
  ]
}
